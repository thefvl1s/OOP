#define IDD_TABLE_DIALOG 201
#define IDC_TABLE_LIST   202

IDD_TABLE_DIALOG DIALOGEX 0, 0, 260, 180
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Таблиця об'єктів"
FONT 9, "Segoe UI"
BEGIN
